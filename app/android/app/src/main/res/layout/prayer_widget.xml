<?xml version="1.0" encoding="utf-8"?>
<!-- PRAYER widget (RemoteViews-safe views only): Hijri date, the next prayer
     with its time, a LIVE countdown, and today's five times.

     Every text except the countdown and the Hijri numbers is pushed
     pre-localized by the Dart side (PrayerWidgetSync.push), so this layout is
     locale-neutral: everything is centred, nothing uses start/end.

     The five-times row is layoutDirection="ltr" ON PURPOSE. A widget inherits
     the DEVICE locale, but its content follows the APP language, and the two
     can disagree (an Arabic app on an English phone). Locking the direction
     and letting Dart push the display order (PrayerWidgetSync.prayerRowOrder,
     reversed for Arabic) makes the order depend on the app language alone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/awwad_widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <TextView
        android:id="@+id/pw_hijri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/pw_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textColor="#ECEFF4"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- The reason this widget exists. Ticked by the system process in
         countdown mode (setChronometerCountDown), so it counts down second by
         second on a surface the app may only redraw every 30 minutes. -->
    <Chronometer
        android:id="@+id/pw_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:gravity="center"
        android:textColor="#2DD4BF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Shown instead of everything above when no location is set yet. -->
    <TextView
        android:id="@+id/pw_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pw_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pw_n0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/pw_t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pw_n1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/pw_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pw_n2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/pw_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pw_n3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/pw_t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pw_n4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/pw_t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
